---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
}

const { title, description, keywords } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/jpeg" sizes="150x150" href="/favicon.jpg" />
		<link rel="apple-touch-icon" href="/favicon.jpg" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		{keywords && <meta name="keywords" content={keywords} />}
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-white text-stone-800 antialiased">
		<main class="flex-1">
			<slot />
		</main>

		<footer class="border-t border-stone-200 bg-stone-50">
			<div class="mx-auto flex max-w-3xl justify-center px-4 py-10 text-lg">
				<nav class="flex flex-wrap justify-center gap-x-8 gap-y-3">
					<a
						href="mailto:protegeonslajoyere@gmail.com"
						class="inline-flex items-center gap-2 font-medium text-lime-700 hover:text-lime-900 hover:underline"
					>
						<svg class="size-6 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="2" y="4" width="20" height="16" rx="2" />
							<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
						</svg>
						protegeonslajoyere@gmail.com
					</a>
					<a
						href="https://www.instagram.com/la_joyere"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 font-medium text-lime-700 hover:text-lime-900 hover:underline"
					>
						<svg class="size-6 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
							<circle cx="12" cy="12" r="4" />
							<line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
						</svg>
						Instagram
					</a>
				</nav>
			</div>
		</footer>
	</body>
</html>
